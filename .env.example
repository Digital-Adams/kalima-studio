# =============================================================
# Kalima Studio — Variables d'environnement (.env.example)
# =============================================================
# Copier ce fichier → .env.local pour le développement local
# Pour Vercel : ajouter ces variables dans Settings > Environment Variables
# =============================================================

# ─── VERCEL BLOB STORAGE (Optionnel / Sauvegardes médias) ───
BLOB_STORE_ID="store_xxxxxxxxxxxxxxxx"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# ─── BASE DE DONNÉES (Neon PostgreSQL / Vercel Postgres) ─────
DATABASE_URL="postgresql://user:password@host/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"

PGHOST="host"
PGHOST_UNPOOLED="host"
PGUSER="user"
PGDATABASE="neondb"
PGPASSWORD="password"

POSTGRES_URL="postgresql://user:password@host/neondb?channel_binding=require&sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host/neondb?channel_binding=require&sslmode=require"
POSTGRES_USER="user"
POSTGRES_HOST="host"
POSTGRES_PASSWORD="password"
POSTGRES_DATABASE="neondb"
POSTGRES_URL_NO_SSL="postgresql://user:password@host/neondb"
POSTGRES_PRISMA_URL="postgresql://user:password@host/neondb?channel_binding=require&connect_timeout=15&sslmode=require"

# ─── APPLICATION & GITHUB ────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://kalima-studio.vercel.app"
NEXT_PUBLIC_GITHUB_DEFAULT_URL="https://raw.githubusercontent.com/Valar-D0haeris/kalima-studio/main/calendar_dataset.json"
